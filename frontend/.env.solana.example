# Solana launchpad configuration (V4 product path)
# Parity plan: docs/solana/bnb-parity-build-plan.md
# Create: Push Live → authorize_solana_v4 → wallet createCampaign
# Trade:  TokenDetails → /api/solana/trade-authorize → buy_tokens/sell_tokens
# Ops smoke: docs/solana/devnet-trade-smoke.md
# Operator CLI: npm --prefix tests/solana run devnet:trade-ops -- status

# Public frontend RPC. Use devnet during buildout.
VITE_SOLANA_RPC=https://api.devnet.solana.com
VITE_SOLANA_CLUSTER=devnet
# Unlock Push Live button for Solana drafts (must match Railway DRAFT_PUSH_LIVE_ENABLED).
# VITE_DRAFT_PUSH_LIVE_ENABLED=true
# Enable $6 test graduation tier on Solana (101) while testing.
# VITE_ENABLE_TEST_GRADUATION_THRESHOLD=true

# Set after V4 program is deployed to devnet (programs/memewarzone_solana).
# Placeholder 1111… is rejected by readiness checks.
# Devnet program (example): 3JSGNiFstsSQEd98GUJduBnceXNg8kh2qWg7zEeZfmBt
VITE_SOLANA_LAUNCHPAD_PROGRAM_ID=

# Static launchpad ALT for user CREATE/BUY/SELL VersionedTransactions.
# Vite-baked. Operator/CI equivalent: SOLANA_LAUNCHPAD_ALT_ADDRESS.
# Distinct from SOLANA_GRADUATION_ALT_ADDRESS.
VITE_SOLANA_LAUNCHPAD_ALT_ADDRESS=

# Honest UI status only (safety adapter). Does not by itself enable trades.
# Set true only after: program upgraded with buy/sell, GlobalConfig unpaused,
# and Railway SOLANA_TRADE_AUTH_ENABLED=true.
# Safety UI: unset/true opens overlay; false re-locks. Hard gate is still Railway
# SOLANA_TRADE_AUTH_ENABLED. Prefer /api/solana/trade-status when API is deployed.
# VITE_SOLANA_TRADE_LIVE=true
# Netlify: also set VITE_SOLANA_TRADE_LIVE=true until FE bundle includes trade-status adapter.

# Generation placeholders consumed by future Solana generation/indexer wiring.
VITE_SOLANA_GENERATION_ID=solana-genesis-devnet
VITE_SOLANA_CONFIG_PDA=
VITE_SOLANA_INDEXER_START_SLOT=
# Post-grad DEX: Meteora DAMM v2 only (product lock). No multi-DEX / Raydium path.
VITE_SOLANA_DEX_ADAPTER=meteora_damm_v2

# Explicit public launch gates. Keep false until the named proof exists in repository
# documentation and devnet acceptance artifacts.
VITE_SOLANA_PROGRAM_PROOF_READY=false
VITE_SOLANA_IDL_READY=false
VITE_SOLANA_INDEXER_READY=false
VITE_SOLANA_DASHBOARD_READY=false
VITE_SOLANA_DEVNET_ACCEPTANCE_READY=false
VITE_SOLANA_SECURITY_DEFAULTS_LOCKED=false

# Defaults required by the parity plan. These are declarations for future wiring,
# not browser-controlled economics.
VITE_SOLANA_ROUTE_AUTHORIZATION_REQUIRED=true
VITE_SOLANA_AUTHORIZED_TRADING_REQUIRED=true
VITE_SOLANA_PRIMARY_DEX_ADAPTER=meteora_damm_v2
# Optional post-grad quote helper only (not a second DEX product).
VITE_SOLANA_POST_GRAD_QUOTE_ROUTER=jupiter

# -----------------------------------------------------------------------------
# Railway/server-only Solana V4 create authorization
# -----------------------------------------------------------------------------
# Never prefix the following values with VITE_. They must never enter the browser bundle.
# The endpoint remains fail-closed until every value is configured and the on-chain state
# agrees with it.
SOLANA_CREATE_AUTH_ENABLED=false
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=solana-devnet
SOLANA_LAUNCHPAD_PROGRAM_ID=
SOLANA_ROUTE_SIGNER_PUBLIC_KEY=
SOLANA_ROUTE_SIGNER_SECRET_KEY=
SOLANA_CLUSTER_HASH_HEX=
# Refresh after each program upgrade (print:railway-create-auth):
SOLANA_LAUNCHPAD_IDL_SHA256=702eb07ae510b6a4d1d7b268528c5c8fc33b26b155a78439f56cb0b84bd255e5
SOLANA_LAUNCHPAD_PROGRAM_SHA256=beab7e1f5e99efdb1dda2a45174c91534164b2ab43ca4ed08035317ea81efbe8
# Must match on-chain GenerationConfig.manifestHash for the ACTIVE generation.
# After every gen switch / upgrade, refresh with:
#   npm --prefix tests/solana run print:railway-create-auth
# Devnet v2 BNB-parity (2026-08-12):
SOLANA_GENERATION_MANIFEST_HASH=0b5c374c2ecfed1dc77d458a2c0e83ba44a340a893a2e8fdfb29ce9064f4d06c
SOLANA_CREATE_AUTH_TTL_SECONDS=600
SOLANA_RPC_TIMEOUT_MS=12000
# Must also be true for /api/drafts/:id/deploy Push Live finalize.
# DRAFT_PUSH_LIVE_ENABLED=false

# Local-validator/CI escape hatch only. Never enable on Railway or public environments.
SOLANA_ALLOW_PLACEHOLDER_PROGRAM_ID=false

# -----------------------------------------------------------------------------
# Railway/server-only Solana V1 trade authorization (buy exact SOL / sell exact tokens)
# -----------------------------------------------------------------------------
# Fail-closed until true. Enable ONLY after:
#   1) Program upgraded with buy_tokens + sell_tokens
#   2) Operator unpaused buy/sell:
#        npm --prefix tests/solana run devnet:trade-ops -- unpause-trade
#   3) Buyer has RiskProfile:
#        npm --prefix tests/solana run devnet:trade-ops -- sync-risk <BUYER>
# Reuses SOLANA_RPC_URL, SOLANA_LAUNCHPAD_PROGRAM_ID, and route signer secret/pubkey.
SOLANA_TRADE_AUTH_ENABLED=false
# SOLANA_TRADE_AUTH_TTL_SECONDS=300
