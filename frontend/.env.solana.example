# Solana launchpad placeholders
# These values are intentionally not enough to mark Solana launchpad actions ready.
# Create, buy, sell, graduation, and claims remain protocol_pending until the full Phase 0 proof gates are signed off and later phases produce real program/indexer/dashboard evidence.

# Public frontend RPC. Use devnet during buildout.
VITE_SOLANA_RPC=https://api.devnet.solana.com
VITE_SOLANA_CLUSTER=devnet

# Placeholder system program ID. Replace only after the real Anchor program is deployed and the generated IDL is committed.
VITE_SOLANA_LAUNCHPAD_PROGRAM_ID=11111111111111111111111111111111

# Generation placeholders consumed by future Solana generation/indexer wiring.
VITE_SOLANA_GENERATION_ID=solana-genesis-devnet
VITE_SOLANA_CONFIG_PDA=
VITE_SOLANA_INDEXER_START_SLOT=
VITE_SOLANA_DEX_ADAPTER=meteora_damm_v2

# Explicit launch gates. Keep false until the named proof exists in repository docs and devnet acceptance artifacts.
VITE_SOLANA_PROGRAM_PROOF_READY=false
VITE_SOLANA_IDL_READY=false
VITE_SOLANA_INDEXER_READY=false
VITE_SOLANA_DASHBOARD_READY=false
VITE_SOLANA_DEVNET_ACCEPTANCE_READY=false
VITE_SOLANA_SECURITY_DEFAULTS_LOCKED=false

# Defaults required by the parity plan. These are declarations for future wiring, not live economics controls.
VITE_SOLANA_ROUTE_AUTHORIZATION_REQUIRED=true
VITE_SOLANA_AUTHORIZED_TRADING_REQUIRED=true
VITE_SOLANA_PRIMARY_DEX_ADAPTER=meteora_damm_v2
VITE_SOLANA_FALLBACK_DEX_ADAPTER=raydium_cpmm
VITE_SOLANA_POST_GRAD_QUOTE_ROUTER=jupiter
