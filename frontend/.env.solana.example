# Solana launchpad configuration
# These values are intentionally not enough to mark Solana launchpad actions ready.
# Create, buy, sell, graduation, and claims remain protocol_pending until the named proof gates are accepted.

# Public frontend RPC. Use devnet during buildout.
VITE_SOLANA_RPC=https://api.devnet.solana.com
VITE_SOLANA_CLUSTER=devnet

# Placeholder system program ID. Replace only after the real Anchor program is deployed
# and the generated IDL plus deployment hashes are accepted.
VITE_SOLANA_LAUNCHPAD_PROGRAM_ID=11111111111111111111111111111111

# Generation placeholders consumed by future Solana generation/indexer wiring.
VITE_SOLANA_GENERATION_ID=solana-genesis-devnet
VITE_SOLANA_CONFIG_PDA=
VITE_SOLANA_INDEXER_START_SLOT=
VITE_SOLANA_DEX_ADAPTER=meteora_damm_v2

# Explicit public launch gates. Keep false until the named proof exists in repository
# documentation and devnet acceptance artifacts.
VITE_SOLANA_PROGRAM_PROOF_READY=false
VITE_SOLANA_IDL_READY=false
VITE_SOLANA_INDEXER_READY=false
VITE_SOLANA_DASHBOARD_READY=false
VITE_SOLANA_DEVNET_ACCEPTANCE_READY=false
VITE_SOLANA_SECURITY_DEFAULTS_LOCKED=false

# Defaults required by the parity plan. These are declarations for future wiring,
# not browser-controlled economics.
VITE_SOLANA_ROUTE_AUTHORIZATION_REQUIRED=true
VITE_SOLANA_AUTHORIZED_TRADING_REQUIRED=true
VITE_SOLANA_PRIMARY_DEX_ADAPTER=meteora_damm_v2
VITE_SOLANA_FALLBACK_DEX_ADAPTER=raydium_cpmm
VITE_SOLANA_POST_GRAD_QUOTE_ROUTER=jupiter

# -----------------------------------------------------------------------------
# Railway/server-only Solana V4 create authorization
# -----------------------------------------------------------------------------
# Never prefix the following values with VITE_. They must never enter the browser bundle.
# The endpoint remains fail-closed until every value is configured and the on-chain state
# agrees with it.
SOLANA_CREATE_AUTH_ENABLED=false
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=solana-devnet
SOLANA_LAUNCHPAD_PROGRAM_ID=
SOLANA_ROUTE_SIGNER_PUBLIC_KEY=
SOLANA_ROUTE_SIGNER_SECRET_KEY=
SOLANA_CLUSTER_HASH_HEX=
SOLANA_LAUNCHPAD_IDL_SHA256=
SOLANA_LAUNCHPAD_PROGRAM_SHA256=
SOLANA_GENERATION_MANIFEST_HASH=
SOLANA_CREATE_AUTH_TTL_SECONDS=600
SOLANA_RPC_TIMEOUT_MS=12000

# Local-validator/CI escape hatch only. Never enable on Railway or public environments.
SOLANA_ALLOW_PLACEHOLDER_PROGRAM_ID=false
