# Copy to frontend/.env.local for localhost that mimics Netlify + Railway.
# Do not point this to 127.0.0.1 unless you intentionally want the local API.

VITE_RAILWAY_API_BASE=https://your-railway-api.up.railway.app

# Optional. If omitted, dev:railway uses VITE_RAILWAY_API_BASE for realtime routes too.
VITE_REALTIME_API_BASE=https://your-railway-api.up.railway.app

# Optional local frontend port.
VITE_PORT=5173
