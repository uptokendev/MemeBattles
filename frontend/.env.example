# MemeBattles Frontend Environment (Vite)

# Chain configuration
# Reads follow the wallet chain automatically (if allowed); otherwise we fall back to default.
VITE_ALLOWED_CHAIN_IDS=56,97
VITE_DEFAULT_CHAIN_ID=97

# Local QA feed split:
# - Campaign-style feeds use BNB testnet so locally deployed factory test tokens are visible.
# - Draft discovery uses BNB mainnet so public Prepare Mode drafts match the dev live site.
# - Create/deploy actions still follow the connected wallet/default chain rules above.
VITE_CAMPAIGN_FEED_CHAIN_ID=97
VITE_FEATURED_FEED_CHAIN_ID=97
VITE_TICKER_FEED_CHAIN_ID=97
VITE_WAR_ROOM_CHAIN_ID=97
VITE_DRAFT_FEED_CHAIN_ID=56

# Public RPCs used for read-only calls (logs, balances, etc)
VITE_PUBLIC_RPC_97=https://data-seed-prebsc-1-s1.binance.org:8545/
VITE_PUBLIC_RPC_56=https://bsc-dataseed.binance.org/

# VITE_FACTORY_ADDRESS_97=0x...
# VITE_FACTORY_ADDRESS_56=0x...

# Optional realtime-indexer base for recruiter / reward program / activity data.
# Local frontend dev falls back to http://localhost:3000 automatically.
# VITE_REALTIME_API_BASE=https://memebattles-production.up.railway.app

# -----------------------------
# Dev API proxy
# -----------------------------

# devpostgrad is not the live API branch. For local dev-hybrid runs, proxy API calls to Railway services connected to dev.
# Copy these into frontend/.env.local for local staging mode. Keep strict mode on so missing Railway routes fail visibly.
API_RAILWAY_PROXY=true
API_RAILWAY_PROXY_STRICT=true

# Frontend/product API service: memewarzonefrontend-production.
# Current live dev behavior proxies all active /api/* app routes here, including campaigns, drafts, token metadata, epoch pools, votes, profile, prepare, Arena, War Room, sponsorship, recruiter, rewards, and social routes.
RAILWAY_FRONTEND_API_BASE_URL=https://memewarzonefrontend-production.up.railway.app
# Compatibility aliases if an environment already uses these names:
# FRONTEND_RAILWAY_API_BASE_URL=https://memewarzonefrontend-production.up.railway.app
# MEMEWARZONE_FRONTEND_API_BASE_URL=https://memewarzonefrontend-production.up.railway.app

# Token/indexer service: memebattles-production.
# Keep this available for future non-/api indexer routes or realtime services, but current /api/* localhost parity is owned by the frontend/product gateway above.
RAILWAY_TOKEN_API_BASE_URL=https://memebattles-production.up.railway.app
# Compatibility aliases if an environment already uses these names:
# TOKEN_RAILWAY_API_BASE_URL=https://memebattles-production.up.railway.app
# RAILWAY_INDEXER_URL=https://memebattles-production.up.railway.app

# Legacy single-upstream fallback. Used only when a route's service-specific upstream is not set.
# Prefer the two service-specific variables above for devpostgrad local work.
RAILWAY_API_BASE_URL=https://memebattles-production.up.railway.app

# Local route ownership summary:
# - frontend/product Railway: current /api/* app routes, including /api/campaigns, /api/drafts/*, /api/token-metadata, /api/epochPools, /api/vote_counts, /api/votes, /api/arena/*, /api/war-room, /api/sponsored, /api/sponsorship-applications, /api/profile/*, and /api/prepare/*
# - token/indexer Railway: health-checked and reserved for future non-/api indexer/realtime routes until concrete routes are confirmed there
# - devpostgrad does not host real API handlers locally; it runs a strict gateway to Railway.

# Optional: per-chain UP Vote treasury (enables "UP Vote" button)
# VITE_VOTE_TREASURY_ADDRESS_97=0x...
# VITE_VOTE_TREASURY_ADDRESS_56=0x...

# -----------------------------
# Post-grad feature flags
# -----------------------------

# Master gate for the additive post-grad experience.
# On the devpostgrad branch, local Vite dev defaults this sandbox to ON when these are unset.
# Production/staged builds remain gated unless explicitly set to true.
VITE_ENABLE_POSTGRAD=false
VITE_ENABLE_POSTGRAD_ARENA=false
VITE_ENABLE_POSTGRAD_WAR_ROOM=false
VITE_ENABLE_POSTGRAD_BATTLE=false
VITE_ENABLE_POSTGRAD_EVENTS=false
VITE_ENABLE_POSTGRAD_LEAGUE=false
VITE_ENABLE_POSTGRAD_TOURNAMENT=false

# Frontend-only mock roster for testing battle, arena, war room, and event flows.
# Mock data is always explicit opt-in so production/staged builds do not expose fake battle, payout, or settlement data.
VITE_ENABLE_POSTGRAD_MOCKS=false

# For explicit local sandbox testing, copy these into frontend/.env.local:
# VITE_ENABLE_POSTGRAD=true
# VITE_ENABLE_POSTGRAD_ARENA=true
# VITE_ENABLE_POSTGRAD_WAR_ROOM=true
# VITE_ENABLE_POSTGRAD_BATTLE=true
# VITE_ENABLE_POSTGRAD_EVENTS=true
# VITE_ENABLE_POSTGRAD_LEAGUE=true
# VITE_ENABLE_POSTGRAD_TOURNAMENT=true
# VITE_ENABLE_POSTGRAD_MOCKS=true

# -----------------------------
# Server-only post-grad readiness flags
# -----------------------------

# These gate the additive post-grad backend routes in frontend/api/server.mjs.
# Keep production values false until the matching DB imports, contract addresses/ABIs, and QA gates are verified.
POSTGRAD_ARENA_OPS_ENABLED=false
POSTGRAD_BATTLES_ENABLED=false
POSTGRAD_EVENTS_ENABLED=false
POSTGRAD_LEAGUE_ENABLED=false
POSTGRAD_WAR_POOLS_ENABLED=false
POSTGRAD_SPONSORSHIPS_ENABLED=false
POSTGRAD_WAR_ROOM_ENABLED=false

# For local API sandbox testing, copy these into frontend/.env.local only after importing the matching database SQL files:
# POSTGRAD_ARENA_OPS_ENABLED=true
# POSTGRAD_BATTLES_ENABLED=true
# POSTGRAD_EVENTS_ENABLED=true
# POSTGRAD_LEAGUE_ENABLED=true
# POSTGRAD_WAR_POOLS_ENABLED=true
# POSTGRAD_SPONSORSHIPS_ENABLED=true
# POSTGRAD_WAR_ROOM_ENABLED=true

# -----------------------------
# Server-only (Vercel Functions)
# -----------------------------

# Private status token used by /api/status
STATUS_TOKEN=

# Telemetry service endpoint (Railway)
TELEMETRY_STATUS_URL=

# -----------------------------
# League auto-payout (Option A)
# -----------------------------

# RPC used by serverless functions for on-chain payouts
# (diagnostics.js already reads BSC_RPC_HTTP_97; keep same naming)
BSC_RPC_HTTP_97=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_RPC_HTTP_56=https://bsc-dataseed.binance.org/

# TreasuryVaultV2 addresses (chain-specific)
TREASURY_VAULT_V2_ADDRESS_97=
TREASURY_VAULT_V2_ADDRESS_56=

# Operator hot-wallet private key (server-only)
LEAGUE_PAYOUT_OPERATOR_PK=

# Merkle root poster (for user-paid claims)
LEAGUE_ROOT_POSTER_PK=
# Admin key to protect /api/leagueRoot (use a random secret)
ADMIN_API_KEY=

# -----------------------------
# /live livestream page (Mux + Ably-backed launch event)
# -----------------------------

# Public Mux Playback ID (from Mux dashboard -> Video -> Live Streams -> your stream)
VITE_MUX_PLAYBACK_ID=

# Optional chat channel override; defaults to "live:launch-party" in code.
# VITE_LIVE_CHAT_CHANNEL=live:launch-party

# Feature flag; set to "false" to retire the /live route post-launch without removing code.
# VITE_LIVE_PAGE_ENABLED=true

# Comma-separated wallet addresses that render with a moderator shield in chat.
# Case-insensitive match. Same list maintained in mw-dashboard.
# VITE_LIVE_CHAT_MODERATORS=0xabc...,0xdef...
