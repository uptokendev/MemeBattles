# MemeBattles Frontend Environment (Vite)

# Chain configuration
# Reads follow the wallet chain automatically (if allowed); otherwise we fall back to default.
VITE_ALLOWED_CHAIN_IDS=56,97
VITE_DEFAULT_CHAIN_ID=97

# Public RPCs used for read-only calls (logs, balances, etc)
VITE_PUBLIC_RPC_97=https://data-seed-prebsc-1-s1.binance.org:8545/
VITE_PUBLIC_RPC_56=https://bsc-dataseed.binance.org/

# VITE_FACTORY_ADDRESS_97=0x...
# VITE_FACTORY_ADDRESS_56=0x...

# Optional realtime-indexer base for recruiter / reward program / activity data.
# Local frontend dev falls back to http://localhost:3000 automatically.
# VITE_REALTIME_API_BASE=https://memebattles-production.up.railway.app

# Optional: per-chain UP Vote treasury (enables "UP Vote" button)
# VITE_VOTE_TREASURY_ADDRESS_97=0x...
# VITE_VOTE_TREASURY_ADDRESS_56=0x...

# -----------------------------
# Post-grad feature flags
# -----------------------------

# Master gate for the additive post-grad experience.
VITE_ENABLE_POSTGRAD=false
VITE_ENABLE_POSTGRAD_ARENA=false
VITE_ENABLE_POSTGRAD_WAR_ROOM=false
VITE_ENABLE_POSTGRAD_BATTLE=false
VITE_ENABLE_POSTGRAD_EVENTS=false
VITE_ENABLE_POSTGRAD_LEAGUE=false
VITE_ENABLE_POSTGRAD_TOURNAMENT=false

# Frontend-only mock roster for testing battle, arena, war room, and event flows.
VITE_ENABLE_POSTGRAD_MOCKS=false

# -----------------------------
# Server-only (Vercel Functions)
# -----------------------------

# Private status token used by /api/status
STATUS_TOKEN=

# Telemetry service endpoint (Railway)
TELEMETRY_STATUS_URL=

# -----------------------------
# League auto-payout (Option A)
# -----------------------------

# RPC used by serverless functions for on-chain payouts
# (diagnostics.js already reads BSC_RPC_HTTP_97; keep same naming)
BSC_RPC_HTTP_97=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_RPC_HTTP_56=https://bsc-dataseed.binance.org/

# TreasuryVaultV2 addresses (chain-specific)
TREASURY_VAULT_V2_ADDRESS_97=
TREASURY_VAULT_V2_ADDRESS_56=

# Operator hot-wallet private key (server-only)
LEAGUE_PAYOUT_OPERATOR_PK=

# Merkle root poster (for user-paid claims)
LEAGUE_ROOT_POSTER_PK=
# Admin key to protect /api/leagueRoot (use a random secret)
ADMIN_API_KEY=

# -----------------------------
# /live livestream page (Mux + Ably-backed launch event)
# -----------------------------

# Public Mux Playback ID (from Mux dashboard → Video → Live Streams → your stream)
VITE_MUX_PLAYBACK_ID=

# Optional chat channel override; defaults to "live:launch-party" in code.
# VITE_LIVE_CHAT_CHANNEL=live:launch-party

# Feature flag; set to "false" to retire the /live route post-launch without removing code.
# VITE_LIVE_PAGE_ENABLED=true

# Comma-separated wallet addresses that render with a moderator shield in chat.
# Case-insensitive match. Same list maintained in mw-dashboard.
# VITE_LIVE_CHAT_MODERATORS=0xabc...,0xdef...
