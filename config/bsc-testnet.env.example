# BSC testnet deployment environment for devpostgrad.
# Copy these keys into your real .env and replace every placeholder.
# Never commit real private keys or production multisig values.

BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
DEPLOYER_PK=0xREPLACE_WITH_FUNDED_BSC_TESTNET_DEPLOYER_PRIVATE_KEY

# Admin / treasury control. Use a real testnet-controlled safe or admin wallet,
# not a default Hardhat account.
TREASURY_SAFE=0xREPLACE_WITH_TESTNET_TREASURY_SAFE

# Route authorization. Prefer an address controlled by your route signer.
# ROUTE_AUTHORITY_PRIVATE_KEY is accepted only when the deployment environment
# needs to derive or verify the signer locally; do not commit it.
ROUTE_AUTHORITY_ADDRESS=0xREPLACE_WITH_TESTNET_ROUTE_AUTHORITY
# ROUTE_AUTHORITY_PRIVATE_KEY=0xREPLACE_WITH_TESTNET_ROUTE_SIGNER_PRIVATE_KEY

# Topaz testnet addresses. Set the official Topaz v2 router used for graduation.
TOPAZ_ROUTER=0xREPLACE_WITH_TOPAZ_TESTNET_ROUTER

# Graduation oracle. Choose one path:
# 1. Existing deployed GraduationOracle
# GRADUATION_ORACLE_ADDRESS=0xREPLACE_WITH_EXISTING_GRADUATION_ORACLE
#
# 2. Deploy a GraduationOracle from a real BNB/USD feed
BNB_USD_PRICE_FEED=0xREPLACE_WITH_BNB_USD_PRICE_FEED
GRADUATION_ORACLE_MAX_PRICE_AGE_SECONDS=3600

# Route profile IDs: 0=StandardLinked, 1=StandardUnlinked, 2=OgLinked.
PHASE1_TRADE_ROUTE_PROFILE=1
PHASE1_FINALIZE_ROUTE_PROFILE=1

# Optional BscScan verification.
BSCSCAN_API_KEY=REPLACE_WITH_BSCSCAN_API_KEY

# Optional reward operators. Leave unset or set to real testnet operator wallets.
# LEAGUE_PAYOUT_OPERATOR=0xREPLACE_WITH_LEAGUE_PAYOUT_OPERATOR
# LEAGUE_ROOT_POSTER=0xREPLACE_WITH_LEAGUE_ROOT_POSTER
# RECRUITER_PAYOUT_OPERATOR=0xREPLACE_WITH_RECRUITER_PAYOUT_OPERATOR

# Reward lanes stay paused unless explicitly enabled.
ENABLE_LEAGUE_PAYOUTS=false
ENABLE_LEAGUE_CLAIMS=false
ENABLE_RECRUITER_PAYOUTS=false
