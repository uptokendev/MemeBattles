# BSC mainnet (chain 56) deployment environment.
# Copy keys into the production secret manager. Never commit real values.

BSC_MAINNET_RPC_URL=https://REPLACE_WITH_PAID_BSC_MAINNET_RPC
BSC_MAINNET_RPC=https://REPLACE_WITH_PAID_BSC_MAINNET_RPC
DEPLOYER_PK=0xREPLACE_WITH_TEMPORARY_MAINNET_DEPLOYER_PRIVATE_KEY
PRIVATE_KEY_DEPLOY=0xREPLACE_WITH_TEMPORARY_MAINNET_DEPLOYER_PRIVATE_KEY

TREASURY_SAFE=0xREPLACE_WITH_PRODUCTION_MULTISIG
ROUTE_AUTHORITY_ADDRESS=0xREPLACE_WITH_PRODUCTION_ROUTE_SIGNER
REWARD_DISTRIBUTOR_OWNER=0xREPLACE_WITH_PRODUCTION_MULTISIG

TOPAZ_MANIFEST=deployments/bscMainnet/minimal-topaz.json
DEPLOY_TREASURY_ROUTER_V2=true
GRADUATION_ORACLE_ADDRESS=0xREPLACE_WITH_PRODUCTION_GRADUATION_ORACLE
BNB_USD_PRICE_FEED=0xREPLACE_WITH_PRODUCTION_BNB_USD_FEED
GRADUATION_ORACLE_MAX_PRICE_AGE_SECONDS=3600
GRADUATION_TARGET_USD=30000
UPGRADE_DELAY_SECONDS=172800
PROTOCOL_FEE_BPS=200
PHASE1_TRADE_ROUTE_PROFILE=1
PHASE1_FINALIZE_ROUTE_PROFILE=1

ENABLE_LEAGUE_PAYOUTS=false
ENABLE_LEAGUE_CLAIMS=false
ENABLE_RECRUITER_PAYOUTS=false

ETHERSCAN_API_KEY=REPLACE_WITH_ETHERSCAN_API_KEY
